Gem::Specification.new do |s|
  s.name = "ished"
  s.version = "0.1.2"
  s.summary = "IshedDB, written as MongoDB’s official driver of each language (Ruby, as the mongo gem)"
  s.authors = ["Bridge"]
  s.homepage = "https://isheddb.com"
  s.license = "Apache-2.0"
  s.required_ruby_version = ">= 3.1"
  s.files = Dir["lib/**/*.rb"] + ["LICENSE"]
  s.metadata = { "source_code_uri" => "https://github.com/treecode9-arch/ished-drivers", "rubygems_mfa_required" => "true" }
end
